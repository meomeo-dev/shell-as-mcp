{
  "name": "shell-as-mcp",
  "version": "1.0.0",
  "description": "TypeScript MCP server — map shell commands to MCP tools via single-file YAML specs.",
  "main": "dist/src/index.js",
  "bin": {
    "shell-as-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "rebuild": "npm run clean && npm run prepare",
    "clean": "rm -rf dist",
    "prepare": "npm run build && rm -rf dist/shell_as_mcp_defs && cp -r shell_as_mcp_defs dist/shell_as_mcp_defs",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts test/e2e/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meomeo-dev/shell-as-mcp.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/meomeo-dev/shell-as-mcp/issues"
  },
  "homepage": "https://github.com/meomeo-dev/shell-as-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
