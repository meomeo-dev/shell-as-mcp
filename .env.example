# ── Server Core ──────────────────────────────────────────────────────────────
SHELL_AS_MCP_SERVER_NAME=shell-as-mcp 🐚
SHELL_AS_MCP_SERVER_VERSION=1.0.0
# Path to command spec directory (default: ./shell_as_mcp_defs)
SHELL_AS_MCP_SPEC_DIR=./shell_as_mcp_defs

# ── Transport ─────────────────────────────────────────────────────────────────
# stdio | streamable-http  (default: stdio)
SHELL_AS_MCP_TRANSPORT=stdio
# Only relevant when transport=streamable-http
SHELL_AS_MCP_HTTP_HOST=127.0.0.1
SHELL_AS_MCP_HTTP_PORT=3001
SHELL_AS_MCP_HTTP_PATH=/mcp

# ── runprompt__generate_artifact ──────────────────────────────────────────────
# Prerequisites: uv pip install git+https://github.com/chr15m/runprompt
RUNPROMPT_MODEL=openrouter/deepseek/deepseek-v3.2
# Preferred names (BASE_URL / API_KEY are accepted as fallback aliases)
RUNPROMPT_BASE_URL=https://openrouter.ai/api/v1
RUNPROMPT_OPENROUTER_API_KEY=INSERT_YOUR_API_KEY

# ── Sandbox (runprompt sandbox execution) ────────────────────────────────────
# SHELL_AS_MCP_SANDBOX_ENABLE=false
# SHELL_AS_MCP_SANDBOX_FALLBACK_LOCAL=true
# SHELL_AS_MCP_SANDBOX_ALLOWED_DOMAINS=
# SHELL_AS_MCP_SANDBOX_ALLOW_WRITE=
# SHELL_AS_MCP_SANDBOX_DENY_READ=
# SHELL_AS_MCP_SANDBOX_DENY_WRITE=

# ── Filesystem MCP bridge ─────────────────────────────────────────────────────
# SHELL_AS_MCP_FILESYSTEM_MCP_ENABLE=false
# SHELL_AS_MCP_FILESYSTEM_FALLBACK_LOCAL=true
# SHELL_AS_MCP_FILESYSTEM_ROOT=
# SHELL_AS_MCP_FILESYSTEM_SERVER_COMMAND=
# SHELL_AS_MCP_FILESYSTEM_SERVER_ARGS=
# SHELL_AS_MCP_FILESYSTEM_SERVER_ARGS_JSON=

# ── System proxy (passed through to all child scripts) ────────────────────────
http_proxy=http://127.0.0.1:8890
HTTP_PROXY=http://127.0.0.1:8890
https_proxy=http://127.0.0.1:8890
HTTPS_PROXY=http://127.0.0.1:8890
